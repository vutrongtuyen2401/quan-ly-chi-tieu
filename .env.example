GEMINI_API_KEY=your_api_key_here
GEMINI_TIMEOUT=15
GEMINI_MODEL=
JWT_SECRET=your_jwt_secret_here
ALLOWED_ORIGINS=http://localhost:5173
SEED_ADMIN_PASSWORD=

# ── Email cảnh báo "Linh Thạch Sắp Cạn" (SMTP) ──
# Gmail: bật Xác minh 2 bước rồi tạo Mật khẩu ứng dụng tại https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Để trống = dùng SMTP_USER
SMTP_FROM=
# starttls (587) | ssl (465) | none
SMTP_SECURITY=starttls
# Chu kỳ quét nền (phút), 0 = tắt; không gửi lại cùng mức cảnh báo trong N giờ
LOW_FUNDS_CHECK_INTERVAL_MINUTES=30
LOW_FUNDS_RENOTIFY_HOURS=24
