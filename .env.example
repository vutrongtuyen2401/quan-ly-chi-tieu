GEMINI_API_KEY=your_api_key_here
JWT_SECRET=your_jwt_secret_here
ALLOWED_ORIGINS=http://localhost:5173
# Để trống → mật khẩu / Bản Mệnh Hồn Đăng của admin@gmail.com được sinh ngẫu nhiên và in ra console lần đầu khởi tạo DB
SEED_ADMIN_PASSWORD=
SEED_ADMIN_SOUL_LAMP=
# (Tùy chọn) Đường dẫn file SQLite, mặc định app.db
DATABASE_PATH=app.db
# (Tùy chọn) Mặc định server chỉ lắng nghe 127.0.0.1; đặt 0.0.0.0 để mở cho máy khác trong mạng LAN
HOST=127.0.0.1
