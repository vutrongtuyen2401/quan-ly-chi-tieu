GEMINI_API_KEY=your_api_key_here
JWT_SECRET=your_jwt_secret_here
ALLOWED_ORIGINS=http://localhost:5173
SEED_ADMIN_PASSWORD=

# development (mặc định): chưa cấu hình SMTP thì mã reset mật khẩu trả trực tiếp trong API
# production: bắt buộc cấu hình SMTP, mã reset chỉ được gửi qua email
APP_ENV=development
# SMTP để gửi mã reset mật khẩu (ví dụ Gmail: smtp.gmail.com, 587, dùng App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (587) | ssl (465) | none
SMTP_SECURITY=starttls
