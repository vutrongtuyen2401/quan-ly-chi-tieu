GEMINI_API_KEY=your_api_key_here
JWT_SECRET=your_jwt_secret_here
ALLOWED_ORIGINS=http://localhost:5173
# Để trống → mật khẩu / Bản Mệnh Hồn Đăng của admin@gmail.com được sinh ngẫu nhiên và in ra console lần đầu khởi tạo DB
SEED_ADMIN_PASSWORD=
SEED_ADMIN_SOUL_LAMP=
# (Tùy chọn) Đường dẫn file SQLite, mặc định app.db
DATABASE_PATH=app.db
# (Tùy chọn) Mặc định server chỉ lắng nghe 127.0.0.1; đặt 0.0.0.0 để mở cho máy khác trong mạng LAN
HOST=127.0.0.1

# development (mặc định): chưa cấu hình SMTP thì mã reset mật khẩu trả trực tiếp trong API
# production: bắt buộc cấu hình SMTP, mã reset chỉ được gửi qua email
APP_ENV=development
# SMTP để gửi mã reset mật khẩu (ví dụ Gmail: smtp.gmail.com, 587, dùng App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (587) | ssl (465) | none
SMTP_SECURITY=starttls
